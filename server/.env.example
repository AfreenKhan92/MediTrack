# MediTrack Backend — Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Primary data store. Get from: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<AppName>

# ─── Isolated RAG storage smoke test (manual only) ───────────────────────────
# Use a separate disposable database whose name contains "test" or "smoke".
# Do not point this at the primary MONGO_URI or production data.
# RAG_TEST_MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/meditrack_rag_test
# Existing disposable records in that test database; never create them in this script.
# RAG_TEST_USER_ID=<existing-test-user-object-id>
# RAG_TEST_REPORT_ID=<existing-test-report-object-id>
# Optional; defaults to the local embedding service.
# RAG_EMBEDDING_URL=http://127.0.0.1:8001
# RAG_VECTOR_INDEX_NAME=<name-of-your-atlas-vector-index>
# RAG_TOP_K=6
# RAG_MIN_SCORE=<calibrate-during-evaluation>
# OPENROUTER_RAG_MODEL=<optional-rag-model>

# ─── Authentication ───────────────────────────────────────────────────────────
# Use a long, random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=supersecretjwtkey_change_me_in_production

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# File storage for uploaded medical reports. https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── OCR.Space ────────────────────────────────────────────────────────────────
# Free tier (500 req/day): https://ocr.space/ocrapi
# Use "helloworld" for testing only.
OCR_SPACE_API_KEY=helloworld

# ─── OpenRouter (AI) ──────────────────────────────────────────────────────────
# Powers medical document extraction + patient summaries. https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# ─── Redis ────────────────────────────────────────────────────────────────────
# Used for: dashboard caching, family member caching, profile caching,
#           rate limiting on AI/OCR endpoints.
#
# Redis is OPTIONAL — the app continues to work without it (caching degrades
# gracefully to direct MongoDB reads; rate limiting is skipped with a warning).
#
# For local development: redis://localhost:6379
# For Upstash (Vercel-compatible, free tier): https://upstash.com
#   IMPORTANT: Upstash requires TLS — use rediss:// (double 's'), not redis://
#
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
